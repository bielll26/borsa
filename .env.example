# ==========================================
# 10X CONTENT EXPERT - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ==========================================
# CANVA API CREDENTIALS
# ==========================================
# Get these from https://www.canva.com/developers/
# Create an app in the Canva Developer Portal

# Your Canva App Client ID
CANVA_CLIENT_ID=your_client_id_here

# Your Canva App Client Secret
CANVA_CLIENT_SECRET=your_client_secret_here

# OAuth Redirect URI (must match what's configured in Canva Developer Portal)
CANVA_REDIRECT_URI=http://127.0.0.1:3001/oauth/redirect

# Access Token (automatically filled after running OAuth flow)
# Run: python scripts/oauth_flow.py
CANVA_ACCESS_TOKEN=

# Refresh Token (automatically filled after running OAuth flow)
CANVA_REFRESH_TOKEN=

# ==========================================
# CANVA API SETTINGS (OPTIONAL)
# ==========================================

# API Base URL (don't change unless Canva updates their API)
# CANVA_API_BASE_URL=https://api.canva.com/rest

# API Request Timeout in seconds (default: 30)
# CANVA_API_TIMEOUT=30

# Rate limit delay in milliseconds (default: 100)
# CANVA_RATE_LIMIT_DELAY=100

# ==========================================
# OPENAI / WHISPER TRANSCRIPTION (OPTIONAL)
# ==========================================
# For cloud transcription via OpenAI API (no local install needed)
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Local Whisper model: tiny, base, small, medium, large
# Larger = more accurate but slower and more RAM
# tiny (~1GB RAM), base (~1GB), small (~2GB), medium (~5GB), large (~10GB)
WHISPER_MODEL=base

# Whisper language (auto-detect if empty)
# WHISPER_LANGUAGE=en

# ==========================================
# DOCKER (OPTIONAL)
# ==========================================
# If Docker Desktop is installed, Whisper can run in a container
# instead of installing torch + whisper locally (~2GB)
# Set to "true" to prefer Docker for transcription
USE_DOCKER_WHISPER=false

# ==========================================
# FFMPEG (OPTIONAL — for audio/video processing)
# ==========================================
# FFmpeg is required for local Whisper transcription
# If not on PATH, set the full path here
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# ==========================================
# ANTHROPIC API (OPTIONAL)
# ==========================================
# For AI-powered content analysis outside Claude Code
# ANTHROPIC_API_KEY=sk-ant-...

# ==========================================
# TLDRAW CANVAS
# ==========================================
CANVAS_PORT=5173

# ==========================================
# LOGGING (OPTIONAL)
# ==========================================

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
